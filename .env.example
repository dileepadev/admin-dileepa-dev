# Configuration for the dileepa.dev admin.
#
#   cp .env.example .env
#
# **One file, on purpose.** This app is not deployed — it runs on localhost
# against whichever API the URLs below name, and there is no staging or
# production build of it to configure. Splitting it the way `api-dileepa-dev`
# and `dileepa-dev` split theirs would create two files that always hold the
# same values.
#
# To point it at production data, change API_URL. Nothing else about the app
# changes, and the API's own CORS allowlist decides whether it is allowed.
#
# `.env` is gitignored. Only this template is committed, and it must never
# carry a real value.

# --- App -----------------------------------------------------------------
# Where this app runs. Only used to build absolute links back to itself.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- API -----------------------------------------------------------------
# The FastAPI backend. Every read and write goes through it, including image
# uploads — this app never holds a Cloudinary credential.
#
# API_URL is read on the server, which is where every call is made from.
# NEXT_PUBLIC_API_URL ships to the browser and must not hold a secret; it is
# kept in step so a client-side call would reach the same API.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
